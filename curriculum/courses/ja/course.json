{
  "id": "ja",
  "name": "Japanese",
  "nativeName": "日本語",
  "summary": "Kana literacy, everyday politeness, rail & dining survival through unassisted JLPT N1 fluency.",
  "textDirection": "ltr",
  "ttsLocales": [
    "ja-JP"
  ],
  "sttLocale": "ja-JP",
  "tierDescriptions": {
    "essential": "Survival phrases, polite greetings, numbers, prices, menu & station signs, and Hiragana/Katakana recognition.",
    "travel": "Adds Desu/Masu sentence builders, counters, izakaya & restaurant ordering, directions, konbini interactions, and survival Kanji.",
    "conversational": "Unscripted social give-and-take (~JLPT N4-N3): plain/casual forms, past & conditional storytelling, multi-clause connectors, and 400+ Kanji.",
    "fluent": "Complete mastery (JLPT N1): honorific Keigo, nuanced idioms, 2,136 Joyo Kanji, professional register, and unassisted native readings."
  },
  "proficiencyFramework": {
    "name": "JLPT",
    "stages": [
      {
        "id": "ja-stage-1",
        "stageNumber": 1,
        "label": "Stage 1: Kana & Survival",
        "cefrOrJlpt": "Pre-N5",
        "summary": "Immediate arrival confidence: Hiragana & Katakana sound-script literacy, konbini checkout decoding, polite social cushioning, and rail-gate survival.",
        "recommendedTier": "essential"
      },
      {
        "id": "ja-stage-2",
        "stageNumber": 2,
        "label": "Stage 2: JLPT N5",
        "cefrOrJlpt": "JLPT N5",
        "summary": "Core sentence architecture: Desu/Masu politeness, essential particles, Japanese counters, dining & hotel interactions, time expressions, and ~100 foundational Kanji.",
        "recommendedTier": "travel"
      },
      {
        "id": "ja-stage-3",
        "stageNumber": 3,
        "label": "Stage 3: JLPT N4",
        "cefrOrJlpt": "JLPT N4",
        "summary": "Everyday independence: Te-form chains, casual plain speech, potential & volitional verbs, giving/receiving favors, conditional clauses, and ~300 Kanji.",
        "recommendedTier": "travel"
      },
      {
        "id": "ja-stage-4",
        "stageNumber": 4,
        "label": "Stage 4: JLPT N3",
        "cefrOrJlpt": "JLPT N3",
        "summary": "Fluid social conversation: passive & causative-passive nuance, multi-clause storytelling, workplace rapport, regional ear-tuning, and ~650 Kanji.",
        "recommendedTier": "conversational"
      },
      {
        "id": "ja-stage-5",
        "stageNumber": 5,
        "label": "Stage 5: JLPT N2",
        "cefrOrJlpt": "JLPT N2",
        "summary": "Professional & media command: formal written connectors, full Sonkeigo/Kenjougo business honorifics, news & essay comprehension, and ~1,000+ Kanji.",
        "recommendedTier": "conversational"
      },
      {
        "id": "ja-stage-6",
        "stageNumber": 6,
        "label": "Stage 6: JLPT N1 (Full Fluency)",
        "cefrOrJlpt": "JLPT N1",
        "summary": "Unassisted native mastery: literary & classical grammar remnants, subtle rhetorical stance, four-character idioms (yojijukugo), and all 2,136 Jōyō Kanji.",
        "recommendedTier": "fluent"
      }
    ]
  },
